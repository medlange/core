# =====================================================================================
# MedicalOS -- nginx for the `web` service, which serves the first-party viewer.
#
# Mounted at /usr/src/default.conf.template and rendered by `web-entrypoint.sh`, the
# container's CMD, which runs
#     envsubst '${MEDOS_GATEWAY_VIEWER_KEY}${MEDOS_API_VIEWER_AUTHORIZATION}' \
#         < /usr/src/default.conf.template > /etc/nginx/conf.d/default.conf
# and then execs nginx. THE SOURCE PATH IS NOT A CONVENTION OF THIS IMAGE. `nginx:1.27-alpine`
# templates `/etc/nginx/templates/*.template` and would leave anything in /usr/src alone;
# the path is inherited from `ohif/app:v3.9.2`, which this service replaced at 0.4.0 and
# whose entrypoint DID render it. Keeping it costs one mount line and keeps the diff of
# that replacement to the image and the script.
#
# Because envsubst runs over this file, every `$` that nginx must see has to survive it,
# which is what the ALLOWLIST is for: a bare `envsubst` substitutes every `$name` it
# finds, and this template is full of nginx's own `$host`, `$uri`, `$request_uri`. Naming
# the two variables leaves the rest untouched. There is no compose interpolation pass and
# no `$$` escaping either, because the file is mounted from disk rather than inlined in
# docker-compose.yml (the week-0 spike inlined it and needed `$$`).
#
# THIS PROXY IS THE STAND-IN FOR medicalos-gateway
# ------------------------------------------------
# MOS-OPS-005 requires exactly one front door in front of the PACS and gives the viewer no
# route to it; MOS-SAFE-089a's acceptance check 24 asserts "a network capture shows zero
# viewer-to-PACS traffic outside the Gateway". This slice has no gateway (CONTRACT.md
# section 0), so nginx terminates every browser request and forwards it on the compose
# network. It proxies; it does not authorise. Weeks 3-5 replaces it with the real Gateway
# and neither medicalos-config.js nor the extension changes.
# =====================================================================================

# =====================================================================================
# THE VIEWER'S PLATFORM CREDENTIAL FOR /api/
#
# Weeks 3-5 put an `Authenticator` in front of `POST /api/v1/jobs`, so the OHIF toolbar
# button's `fetch` is answered `401` unless the request carries one. `MOS-SAFE-089a` wants
# exactly that -- the button "MUST require the `job.create` permission" -- and `MOS-REL-050`
# is why the check is server-side: a client-side `if (user.can(...))` enforces nothing.
#
# The map preserves the PRODUCTION path and supplies a laptop stand-in, in that order:
#
#   the browser sent an Authorization header  -> forward it unchanged. This is the real
#       deployment: OHIF's `UserAuthenticationService` holds the signed-in clinician's
#       OIDC token and `medos/web/ohif-extension/src/core/client.js` attaches it. Every job then
#       carries the identity of the person who pressed the button.
#   the browser sent none                     -> substitute ${MEDOS_API_VIEWER_AUTHORIZATION}.
#       On this laptop stack that is a `Bearer <api key>` for a principal holding
#       `job.create` / `job.read`, minted with `python -m medos.security.cli issue` and
#       passed in the environment. UNSET BY DEFAULT: the expansion is then empty, nginx
#       forwards nothing, and the API answers `401` -- which is the correct answer when no
#       credential is configured, and is not the same thing as a stack that forgot to ask.
#
# WHAT THIS IS NOT. It is not a PACS credential: `MOS-SAFE-089a` forbids the extension to
# hold one and `MOS-DATA-002` restricts those to medos-gateway. It is a platform API key
# for the control plane, the same shape as the Gateway viewer token below, and it lives in
# this container's rendered config and is never served to a browser --
# `tests/e2e/test_demo.py` greps every file this stack serves for `authorization`,
# `bearer` and `btoa(` with comments stripped.
#
# REPORTED, and the same deviation the Gateway viewer token carries: a shared viewer key
# attributes every job to one principal, so the audit trail cannot say WHICH clinician
# pressed the button. A real deployment leaves this unset and lets the clinician's own
# token pass through.
# =====================================================================================
map $http_authorization $medos_api_authorization {
  default   $http_authorization;
  ""        "${MEDOS_API_VIEWER_AUTHORIZATION}";
}

# -------------------------------------------------------------------------------------
# THE UPLOAD CREDENTIAL, chosen by METHOD (U4). Reads keep the read-only viewer key —
# a leaked reader credential must never alter the archive, which is what the scope
# ceiling is FOR. WRITES (STOW-RS POST) carry ${MEDOS_GATEWAY_UPLOADER_KEY}: a principal
# holding study.write, minted for this surface by the deployment. UNSET BY DEFAULT in
# the template: POST then expands to "Bearer " and the Gateway answers 401, which is
# the correct answer for a deployment that has not decided uploads are allowed — the
# compose stack sets the laptop stand-in explicitly, with a comment saying it is one.
# =====================================================================================
map $request_method $dicomweb_authorization {
  default   "Bearer ${MEDOS_GATEWAY_VIEWER_KEY}";
  POST      "Bearer ${MEDOS_GATEWAY_UPLOADER_KEY}";
}

server {
  listen 80 default_server;
  listen [::]:80 default_server;

  # Relative Location headers. nginx otherwise rebuilds an absolute redirect from `$host`
  # and its OWN listen port, which is 80 inside the container -- so a browser on
  # http://127.0.0.1:3000/medicalos/ is redirected to http://127.0.0.1/medicalos/... and
  # lands on nothing. Measured, not theoretical.
  absolute_redirect off;

  # RE-RESOLVE UPSTREAMS AT REQUEST TIME. 127.0.0.11 is Docker's embedded DNS server.
  #
  # Without this, nginx resolves `medos-api` and `orthanc` ONCE at startup and caches the
  # address for the life of the process. Recreating either container gives it a new IP on
  # the compose network and every proxied request then answers 502 -- the viewer appears
  # broken, the API is perfectly healthy, and its log shows no request at all, which sends
  # the operator looking in the wrong place. Measured: `docker compose up -d` after an edit
  # recreated medos-api and the standalone panel started 502ing until ohif was recreated
  # too.
  #
  # A resolver alone is not enough. nginx only re-resolves when the upstream host in
  # `proxy_pass` is a VARIABLE, which is why each location below sets one -- and why each
  # then has to append `$request_uri` explicitly, since a variable `proxy_pass` disables
  # nginx's automatic URI rewriting.
  resolver 127.0.0.11 valid=10s ipv6=off;
  resolver_timeout 5s;

  # --- the EXTENSION'S deployment configuration ----------------------------------------
  # `app-config.js` is `medos/deploy/compose/medicalos-config.js`, bind-mounted. It used to be
  # OHIF's app-config with the MedicalOS block appended; OHIF is withdrawn, so what is left
  # is `window.MEDICALOS` alone -- the api root, the capability list and the pinned service
  # version that `medos/web/ohif-extension/` reads. The PATH is still OHIF's name for it, kept
  # deliberately: see that file's header. It is served with a `Last-Modified`
  # and an `ETag` and no `Cache-Control`, which makes it heuristically cacheable: a browser
  # may reuse it without revalidating, and an operator who edits the config then watches
  # the viewer ignore the edit has no way to tell that from a config that does not work.
  # Measured, on this stack, while wiring the extension: two reloads still ran `extensions:
  # []`. The bundle hashes its own assets and is cached normally; this one file must not be.
  location = /app-config.js {
    root  /usr/share/nginx/html;
    add_header Cache-Control "no-store";
  }

  # --- the root, which is now a signpost and not a document -----------------------------
  #
  # THE SPA FALLBACK IS GONE, AND THAT IS A SAFETY GAIN RATHER THAN A LOSS.
  # `try_files $uri $uri/ /index.html` served OHIF's shell for EVERY path this origin did
  # not recognise, so the origin answered 200 text/html to anything at all. Three separate
  # defects in this repository are that one line: a root-relative fetch from the
  # first-party viewer came back as OHIF's HTML and read as a stale build; `/dicom-web`
  # looked like a healthy PACS to a CI probe (.github/workflows/tests.yml); and
  # `tests/unit/test_stack_contract.py` had to encode "the body the OHIF nginx actually
  # returns for every unknown path" as a known quantity. An unknown path is now a 404,
  # which is what it is.
  #
  # `location /` IS THE LONGEST PREFIX ONLY WHEN NOTHING ELSE MATCHES. /mos-viewer/,
  # /medicalos/, /api/ and /dicomweb/ are all longer prefixes and win;
  # `= /50x.html` is exact and wins. So this refuses exactly the paths nobody serves.
  location = / { return 302 /mos-viewer/; }
  location / { return 404; }

  # --- the MedicalOS extension package ------------------------------------------------
  # medos/web/ohif-extension/ bind-mounted whole, so /medicalos/standalone/app.js can import
  # /medicalos/src/core/client.js -- the same modules the React extension imports. Served
  # from the OHIF origin so that its fetch('/api/v1/jobs') and its EventSource are
  # same-origin and need no CORS policy on medos-api. See medos/web/ohif-extension/README.md for
  # why a standalone page exists next to a real OHIF extension.
  location = /medicalos  { return 302 /medicalos/standalone/; }
  location = /medicalos/ { return 302 /medicalos/standalone/; }
  location /medicalos/ {
    root  /usr/share/nginx/html;
    index index.html;
    # No caching: these files are edited during development and a 304 from a stale module
    # is an hour of debugging the wrong thing.
    add_header Cache-Control "no-store";
    # An ES module served as application/octet-stream is refused by the browser with a
    # strict-MIME error that names neither the file nor the cause. The base image's
    # mime.types already maps .js; .mjs is added for the same reason, cheaply.
    types {
      text/html   html;
      text/css    css;
      text/javascript js mjs;
      application/json json;
    }
    default_type text/plain;
    try_files $uri $uri/ =404;
  }

  # --- the MedicalOS TRAINING CONSOLE -------------------------------------------------
  # WITHDRAWN at specification 0.4.0 (MOS-UI-100 CUT, section 19.3 CUT; register entry
  # 150). medos/web/training-console is deleted and nothing is mounted at
  # /training-console/; the `location`s that served it went with the tree. This header
  # stays so the absence reads as a decision rather than an oversight. The training-plane
  # API proxy below is untouched: it serves API clients, not a page.
  # -----------------------------------------------------------------------------------
  # /mos-viewer/ -- the FIRST-PARTY viewer (release 0.4.0, viewer/).
  #
  # NOT /viewer/, AND THE REASON IS NOW HISTORICAL. That path was OHIF's own client route:
  # OHIF was a single-page app whose router owned /viewer?StudyInstanceUIDs=... through an
  # SPA fallback in `location /`, and mounting a real directory there made nginx answer 301
  # and serve this page instead, killing every OHIF deep link silently. Measured at the
  # time, not theoretical. OHIF is withdrawn and the fallback with it, so nothing would
  # collide today -- but the path is named in six specification chapters, `15-delivery.md`
  # among them, in this stack's healthcheck, and in every bookmark anyone made. It stays
  # because it is the name, not because it is still the only free one.
  #
  # NO-CACHE, DELIBERATELY. The tree is a bind mount of native ES modules with no build
  # step and no content hashes in their names, so a browser that caches `volume.js` runs
  # yesterday's module against today's `app.js`. That failure is invisible: the page loads,
  # the features that changed simply do not work, and the deployed file on disk is correct.
  # It cost an hour once. Hashed filenames would be the production answer; until this has a
  # build step, the honest one is to tell the browser not to cache it.
  # -----------------------------------------------------------------------------------
  location = /mos-viewer  { return 302 /mos-viewer/; }
  location /mos-viewer/ {
    root  /usr/share/nginx/html;
    index index.html;
    # No caching: native ES modules, no build step, no content hash in any filename. A
    # browser that reuses yesterday's `volume.js` against today's `app.js` produces a page
    # that loads and silently lacks the feature, while the file on disk is correct.
    add_header Cache-Control "no-store";

    # THE MOS-SAFE-001 STATEMENT, PUT INTO THE DOCUMENT BY THE ORIGIN.
    #
    # `MOS-SAFE-001` requires this sentence verbatim in the web UI footer and `MOS-UI-008`
    # binds it to both surfaces. `viewer/` does not carry it: the viewer is a DICOMweb
    # viewer, and a hospital pointing it at their own archive would be asserting something
    # about MedicalOS that is not true of their deployment.
    #
    # SO THE PLATFORM PUTS IT BACK, HERE, IN THE BYTES. The alternative -- passing it
    # through `viewer-config.js` and writing it with JavaScript -- would make a required
    # safety marking depend on a script loading, which is a weaker guarantee than the
    # requirement asks for. `sub_filter` runs on the response body, so the statement is in
    # the HTML the browser parses before any module has run.
    #
    # `sub_filter_once` IS DEFAULT-ON AND THAT IS WHAT IS WANTED: the marker appears once
    # and a second substitution would mean the document changed under us.
    # `sub_filter_types` is unnecessary -- text/html is always filtered -- and naming it
    # would be the kind of redundancy that reads as a requirement.
    sub_filter '<!--HOST_STATEMENT-->' 'MedicalOS integrates, governs and evidences medical AI services. It does not diagnose, does not replace a PACS, and is not itself a medical device.';
    # An ES module served as application/octet-stream is refused by the browser with a
    # strict-MIME error naming neither the file nor the cause.
    types {
      text/html   html;
      text/css    css;
      text/javascript js mjs;
      application/json json;
    }
    default_type text/plain;
  }

  # --- MedicalOS TRAINING plane ------------------------------------------------------
  # These prefixes are routed to `medos-train-api`, which runs
  # `medos.api.training_plane:create_training_app` and mounts the training routers on top of
  # the control plane's set; `medos-api` runs `medos.api.app:create_app` and never sees them.
  # The block used to open by explaining why the training CONSOLE was served from this
  # origin; the console is withdrawn at specification 0.4.0 (MOS-UI-100 CUT, register entry
  # 150) and the proxy below remains because it serves the training-plane API itself -- the
  # machine interface to the pipeline -- not any page.
  #
  # THE HISTORY THE CONSOLE LEFT BEHIND, because it is why the override exists: while the
  # console was served here, every /api/ path went to `medos-api`, which mounts six routers
  # -- jobs, model-versions, result-reviews, results, service-versions, users -- and not the
  # training routers. The console's own fetches answered 404 with a MedOS problem+json body
  # that read like a missing record rather than a missing route; sixteen e2e tests asserted
  # against it and every one of them failed, none having ever run on the machine that wrote
  # them.
  #
  # THE PREFIXES BELOW ARE THE TRAINING PLANE'S ALONE. `medos-train-api` serves a superset
  # -- all six of the control plane's prefixes as well -- so routing more than this here
  # would work and would put control-plane traffic on a service that carries `profiles:
  # [training]`. A regex location takes precedence over the `/api/` prefix below it, which
  # is what makes this an override rather than a reordering.
  #
  # The upstream is a VARIABLE for the reason given at the top of this file, and for a
  # second one: `medos-train-api` is profiled, so on a default `docker compose up` it does
  # not exist. A literal upstream would fail nginx at startup and take the viewer with it;
  # a variable one resolves per request and answers 502 for these paths alone.
  location ~ ^/api/v1/(annotation-sets|capabilities|configuration-searches|conversion-runs|dataset-splits|dataset-versions|datasets|harvest-batches|harvest-candidates|sampling-plans|seal-runs|tenants|training-runs)(/|$) {
    set $medos_train medos-train-api;
    proxy_pass         http://$medos_train:8000$request_uri;
    proxy_http_version 1.1;
    proxy_set_header   Authorization $medos_api_authorization;
    proxy_set_header   Host $host;
    proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
  }

  # --- MedicalOS control plane -------------------------------------------------------
  # POST /api/v1/jobs, GET /api/v1/jobs/{id}, GET /api/v1/jobs/{id}/events, and
  # GET /api/v1/capabilities -- the last added by Core as the dependency-edge surface the
  # viewer's analyze dialog builds its closure from (CONTRACT.md section 7).
  #
  # THE EXACT MATCH EXISTS BECAUSE OF THE TRAINING REGEX BELOW. That regex's alternation
  # lists `capabilities` for the Train plane's `/capabilities/{id}/seed-variance`
  # (routes_training.py), and a regex location beats the `/api/` prefix -- so without this
  # line the bare Core path `/api/v1/capabilities` matched the regex, was proxied to
  # `medos-train-api`, and 502'd on every default `up` where the training profile is off.
  # Measured 2026-10-03. An exact location is checked BEFORE any regex, so this one
  # reclaims the bare path while `/capabilities/...` deeper paths keep going to Train.
  location = /api/v1/capabilities {
    set $medos_api medos-api;
    proxy_pass         http://$medos_api:8000$request_uri;
    proxy_http_version 1.1;
    proxy_set_header   Authorization $medos_api_authorization;
    proxy_set_header   Host $host;
    proxy_set_header   X-Real-IP $remote_addr;
    proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
  }

  location /api/ {
    set $medos_api medos-api;
    proxy_pass         http://$medos_api:8000$request_uri;
    proxy_http_version 1.1;
    # The caller's own token, or the laptop stand-in when it sent none. See the `map` at
    # the top of this file for which, and why the production path is the first branch.
    proxy_set_header   Authorization $medos_api_authorization;
    proxy_set_header   Host $host;
    proxy_set_header   X-Real-IP $remote_addr;
    proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
    # MOS-API-004's trace id is a response header; nothing here strips it.
    #
    # SSE (GET /api/v1/jobs/{id}/events) dies without all three of these: buffering makes
    # nginx hold the stream until the response completes, which for an event stream is
    # never; the 60s default read timeout closes a stream that is merely idle between
    # steps; and chunked re-encoding breaks the `id:`/`data:` framing some clients parse.
    proxy_buffering    off;
    proxy_cache        off;
    proxy_read_timeout 3600s;
    chunked_transfer_encoding off;
  }

  # --- DICOMweb, same origin, THROUGH THE GATEWAY ------------------------------------
  # This block used to proxy to `orthanc` directly. 15.2.4 item 3 re-pointed it, and
  # MOS-DATA-006 removed the route it used: `orthanc` is not on this container's network
  # any more, so a revert of these lines fails to resolve instead of quietly restoring
  # direct PACS access.
  #
  # MOS-DATA-015 configures the clinician surface against `/dicomweb/{t}`; that path is
  # passed through
  # unchanged so the Gateway sees the tenant segment it must compare against the
  # principal's tenant (MOS-DATA-009).
  location /dicomweb/ {
    set $medos_gw medos-gateway;
    proxy_pass         http://$medos_gw:8043$request_uri;
    proxy_http_version 1.1;

    # The reader's credential: the viewer's read-only Gateway key for reads; the
    # uploader key (map above, POST only) for STOW-RS writes. MOS-DATA-017 names the
    # header and the scheme. `$viewer_key` comes from the environment via the
    # entrypoint's envsubst -- see the header of this file.
    #
    # This is the laptop stack's stand-in for an authenticated clinician. A real
    # deployment puts an OIDC token from the user's own session here, which is the whole
    # reason MOS-DATA-022's audit row has an `actor` and an `on_behalf_of`: with a shared
    # viewer key, every clinical_viewer access is attributed to `user:ohif-viewer` and the
    # per-patient trail cannot say WHICH clinician looked. REPORTED.
    proxy_set_header   Authorization $dicomweb_authorization;

    proxy_set_header   Host $host;
    proxy_set_header   X-Real-IP $remote_addr;
    proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
    # WADO-RS streams large multipart bodies (MOS-DATA-023); buffering them to disk first
    # is what makes a 237-slice series feel like the viewer has hung.
    proxy_buffering    off;
    client_max_body_size 0;
    proxy_read_timeout 300s;
  }

  # WADO-URI (`/wado?requestType=WADO&...`) is DELIBERATELY NOT PROXIED. MOS-DATA-007
  # lists the twelve routes the Gateway exposes and WADO-URI is not among them;
  # MOS-DATA-008 forbids "any path that proxies an unmatched URL to the backend", and a
  # `location /wado` here would be exactly that path, one hop earlier.
  #
  # THE MECHANISM CHANGED WITH THE VIEWER AND THE CONCLUSION DID NOT. This used to read
  # that "the viewer sets `wadoUriRoot` to the same `/dicomweb/{t}` root" and that
  # `imageRendering: 'wadors'` kept OHIF off the URI form -- both keys of the `window.config`
  # block that went with the OHIF withdrawal. `viewer/` has no such configuration: it
  # issues WADO-RS against `/dicomweb/{t}` and knows no URI form at all
  # (`src/dicom/dicomweb.js`). So the route stays unproxied for the same reason, and there
  # is now no client that could ask for it.

  error_page 500 502 503 504 /50x.html;
  location = /50x.html { root /usr/share/nginx/html; }
}
